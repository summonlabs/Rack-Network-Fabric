@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The exported target already carries the include directories, the C++20
# requirement and the platform socket library. Threads is the only external
# dependency and it is always available.
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/rnfTargets.cmake")

set(RNF_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(RNF_LIBRARIES RNF::rnf)
set(RNF_VERSION "@PROJECT_VERSION@")

check_required_components(rnf)
